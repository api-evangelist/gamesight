            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "with_names",
                "value": "",
                "type": "query",
                "description": "Pass `true` to include Tracker names in the response, defaults to `false`"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Pass a limit to restrict the number of results in the API response. Returns all trackers by default"
              },
              {
                "name": "after_shortcode",
                "value": "",
                "type": "query",
                "description": "Pass a tracker shortcode to page through Trackers, results are ordered by shortcode. Use in combination with limit for pagination."
              },
              {
                "name": "updated_after",
                "value": "",
                "type": "query",
                "description": "Pass to filter results to only include Trackers that were updated after the specified timestamp"
              }
            ]
          },
          "docs": "/trackers"
        },

            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "query",
                "description": "Org ID for the Organization to pull audit logs from"
              },
              {
                "name": "start_datetime",
                "value": "",
                "type": "query",
                "description": "Start of the time range to pull logs from, inclusive. ISO 8601 format, UTC."
              },
              {
                "name": "end_datetime",
                "value": "",
                "type": "query",
                "description": "End of the time range to pull audit logs from, inclusive. ISO 8601 format, UTC."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Min: 1, Max: 500"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor"
              }
